# =========================================================================
# Land Lots Enterprise Environment Configuration (Template)
# Copy this file to .env and adjust variables for your target deployment
# =========================================================================

# --- API Gateway & Server ---
PORT=5001
# NODE_ENV is intentionally not set here: Vite reads this file and NODE_ENV=development
# turns `vite build` into a dev build (dev React runtime, demo logins left in).
# Set NODE_ENV=production in the host environment when deploying the API server.
# REQUIRED in production (32+ random chars), e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Database Engine ---
# Primary: Managed Cloud PostgreSQL (Supabase / Neon DB / Render)
# Format: postgresql://[user]:[password]@[host]:5432/[dbname]?sslmode=require
# If left blank, server defaults gracefully to high-performance local SQLite 3 (WAL Mode)
DATABASE_URL=

# --- Frontend Client ---
# Optional API override (read by src/utils/apiClient.js). Leave unset in production:
# the app then calls same-origin /api, served by server/server.js.
# VITE_API_URL=http://localhost:5001/api
